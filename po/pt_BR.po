#: data/org.capivaraos.Fetch.desktop.in:2
#: data/org.capivaraos.Fetch.metainfo.xml.in:8
msgid "Capivara Fetch"
msgstr "Capivara Fetch"

#: data/org.capivaraos.Fetch.desktop.in:3
msgid "System Information"
msgstr "Informações do Sistema"

#: data/org.capivaraos.Fetch.desktop.in:4
msgid "View your system specs and share a card"
msgstr "Veja as especificações do sistema e compartilhe um cartão"

#: data/org.capivaraos.Fetch.desktop.in:10
msgid "system;info;specs;hardware;neofetch;capybara;capivara;"
